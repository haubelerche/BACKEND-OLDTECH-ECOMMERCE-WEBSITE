# Two-Factor Authentication Password Reset Workflow
# This file demonstrates options for resetting a password with 2FA

### Step 0: Check if 2FA is enabled for the user
GET http://localhost:8080/oldtech/auth/2fa/status?email=user@example.com

### OPTION 1: SIMPLIFIED ONE-STEP PROCESS (RECOMMENDED)
# This is easier for users - they provide the 2FA code and new password in one step

POST http://localhost:8080/oldtech/auth/2fa/reset-password-simple
Content-Type: application/json

{
  "email": "user@example.com",
  "code": "123456",
  "newPassword": "your-new-password"
}

### OPTION 2: TWO-STEP PROCESS
# Only use this option if you need to separate verification from password reset

# Step 1: Get QR code (if user has lost access to their authenticator app)
GET http://localhost:8080/oldtech/auth/2fa/recover-qr?email=user@example.com

# Step 2: Verify the 2FA code to get a temporary token
POST http://localhost:8080/oldtech/auth/2fa/verify-code
Content-Type: application/json

{
  "email": "user@example.com",
  "code": "123456"  # Code from authenticator app
}

# Step 3: Reset password using the token received in Step 2
POST http://localhost:8080/oldtech/auth/2fa/reset-password
Content-Type: application/json

{
  "email": "user@example.com",
  "token": "returned-token-from-step-2",  # Token received from /verify-code
  "newPassword": "your-new-password"
}
